{
  "name": "01 - Order Approval (Telegram)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-approval",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "CAP Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "webhookId": "a1000000-0000-4000-8000-000000000001",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "CAP Webhook Key"
        }
      },
      "notes": "CAP after-CREATE posts here. Header Auth credential must send X-API-Key."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "ID",
              "value": "={{ $json.body.ID }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "customer",
              "value": "={{ $json.body.customer }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "product",
              "value": "={{ $json.body.product }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "qty",
              "value": "={{ Number($json.body.qty) }}",
              "type": "number"
            },
            {
              "id": "f5",
              "name": "amount",
              "value": "={{ Number($json.body.amount) }}",
              "type": "number"
            },
            {
              "id": "f6",
              "name": "currency",
              "value": "={{ $json.body.currency || 'TRY' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Siparis Bilgileri",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        20,
        300
      ],
      "notes": "Flattens the webhook body and forces amount/qty to numbers so the IF compares numerically."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.amount }}",
              "rightValue": 10000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Tutar > 10.000 mu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "chatId": "<CHAT_ID>",
        "message": "=*Onay Bekleyen Siparis*\n\nMusteri: {{ $json.customer }}\nUrun: {{ $json.product }}\nAdet: {{ $json.qty }}\nTutar: *{{ $json.amount }} {{ $json.currency }}*\n\nSiparis No: `{{ $json.ID }}`\n\nTutar 10.000 TRY esigini astigi icin manuel onay gerekiyor.",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Onayla",
            "disapproveLabel": "Reddet"
          }
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Telegram Onay Iste",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        180
      ],
      "webhookId": "a1000000-0000-4000-8000-000000000014",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "notes": "Replace <CHAT_ID> with your own chat id. Outputs { data: { approved: true|false } }."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Onaylandi mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4004/odata/v4/order/approve",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ID: $('Siparis Bilgileri').item.json.ID, approvedBy: 'Telegram' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "CAP approve (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        80
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "chatId": "<CHAT_ID>",
        "message": "=*Ret Gerekcesi*\n\nSiparis {{ $('Siparis Bilgileri').item.json.ID }} reddedildi.\nLutfen kisa bir gerekce yaz.",
        "responseType": "freeText",
        "options": {
          "messageButtonLabel": "Gerekce Yaz",
          "formTitle": "Ret Gerekcesi",
          "formDescription": "Bu siparisin neden reddedildigini yaz."
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Ret Sebebi Sor",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        940,
        300
      ],
      "webhookId": "a1000000-0000-4000-8000-000000000019",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "notes": "Only on the reject path: approving stays one tap. Output is $json.data.text."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4004/odata/v4/order/reject",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ID: $('Siparis Bilgileri').item.json.ID, reason: ($json.data && $json.data.text) ? $json.data.text : 'Telegram uzerinden reddedildi' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "CAP reject (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        300
      ],
      "notes": "Reason comes from the Telegram follow-up; falls back if none was typed."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4004/odata/v4/order/approve",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ID: $json.ID, approvedBy: 'auto-rule' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "CAP approve (auto-rule)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        440
      ],
      "notes": "Under the threshold: approved automatically, no human in the loop."
    }
  ],
  "connections": {
    "CAP Webhook": {
      "main": [
        [
          {
            "node": "Siparis Bilgileri",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Siparis Bilgileri": {
      "main": [
        [
          {
            "node": "Tutar > 10.000 mu?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tutar > 10.000 mu?": {
      "main": [
        [
          {
            "node": "Telegram Onay Iste",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "CAP approve (auto-rule)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Onay Iste": {
      "main": [
        [
          {
            "node": "Onaylandi mi?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Onaylandi mi?": {
      "main": [
        [
          {
            "node": "CAP approve (Telegram)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ret Sebebi Sor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ret Sebebi Sor": {
      "main": [
        [
          {
            "node": "CAP reject (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "sit-ankara-order-demo"
  },
  "tags": []
}
