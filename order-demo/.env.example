# ---------------------------------------------------------------------------
# order-demo environment
# Copy this file to `.env` (same folder as package.json) before `cds watch`.
# No Docker: n8n and CAP both run on the host, so plain localhost URLs.
# ---------------------------------------------------------------------------

# Production webhook of workflow 01-order-approval.
# While you are still building the workflow in the n8n editor, swap
# /webhook/ for /webhook-test/ and press "Test workflow" in n8n first.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/order-approval

# Must match the "CAP Webhook Key" Header Auth credential in n8n.
N8N_WEBHOOK_KEY=sit-ankara-2026

# How long CAP waits for n8n before giving up (order is created either way).
N8N_WEBHOOK_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Offline fallback: point CAP at workflow 04-order-approval-OFFLINE instead.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/order-approval-offline
# ---------------------------------------------------------------------------
